# Copy this file to .env and edit.

# ---- LLM used to write answers --------------------------------------------
# none              -> no LLM; the app returns the most relevant passages (works out of the box)
# ollama            -> free local model (install https://ollama.com, then: ollama pull qwen2.5:3b)
# openai_compatible -> any OpenAI-compatible API, e.g. Groq's free tier
# anthropic         -> Claude (set ANTHROPIC_API_KEY)
LLM_PROVIDER=none

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=llama-3.3-70b-versatile

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium

# ---- Retrieval ------------------------------------------------------------
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# After fine-tuning:  EMBEDDING_MODEL=models/bhasha-e5-finetuned
USE_RERANKER=true
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
TOP_K=5
CANDIDATES=25
CHUNK_TOKENS=300
CHUNK_OVERLAP_TOKENS=50

# Once the models are downloaded, skip the online update check for faster, offline startup.
# (Turn this off again if you switch EMBEDDING_MODEL / RERANKER_MODEL to a new model.)
# HF_HUB_OFFLINE=1

# ---- Ingestion ------------------------------------------------------------
MAX_UPLOAD_MB=50
ENABLE_OCR=false
# Leave empty to auto-detect (PATH, then C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=
